[
  {
    "iso2": "CZ",
    "callingCode": "+420",
    "trunkPrefix": "",
    "internationalPrefix": "00",
    "nsnLengths": [9],
    "formats": {
      "national": "XXX XXX XXX (closed plan, no trunk prefix)",
      "international": "+420 XXX XXX XXX"
    },
    "patterns": [
      { "label": "Prague (2xx)", "national": "2XX XXX XXX", "international": "+420 2XX XXX XXX" },
      { "label": "Other geographic (3xx–5xx)", "national": "5XX XXX XXX", "international": "+420 5XX XXX XXX" },
      { "label": "Mobile (6xx, 7xx)", "national": "6XX XXX XXX", "international": "+420 6XX XXX XXX" },
      { "label": "Freephone (zelená linka)", "national": "800 XXX XXX", "international": "+420 800 XXX XXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+420224123456", "international": "+420 224 123 456", "national": "224 123 456", "note": "Prague — geographic numbers there begin with 2" },
      { "type": "fixed-line", "e164": "+420541123456", "international": "+420 541 123 456", "national": "541 123 456", "note": "Brno — 5xx range" },
      { "type": "mobile", "e164": "+420602123456", "international": "+420 602 123 456", "national": "602 123 456", "note": "Mobile — 602 is an O2 Czech Republic range" },
      { "type": "toll-free", "e164": "+420800123456", "international": "+420 800 123 456", "national": "800 123 456", "note": "Zelená linka (freephone)" }
    ],
    "notes": [
      "Czechia adopted a closed 9-digit plan on 2002-09-22 and dropped the trunk prefix 0; the full number is dialled for every call.",
      "Numbers are conventionally grouped in threes."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_the_Czech_Republic",
      "ČTÚ — číslovací plán: https://ctu.gov.cz/"
    ]
  },
  {
    "iso2": "SK",
    "callingCode": "+421",
    "trunkPrefix": "0",
    "internationalPrefix": "00",
    "nsnLengths": [9],
    "formats": {
      "national": "0A/XXXX XXXX (Bratislava) / 0AA/XXX XXXX (elsewhere)",
      "international": "+421 A XXXX XXXX (trunk 0 dropped)"
    },
    "patterns": [
      { "label": "Bratislava (area code 2)", "national": "02/XXXX XXXX", "international": "+421 2 XXXX XXXX" },
      { "label": "Other geographic (2-digit area codes)", "national": "0XX/XXX XXXX", "international": "+421 XX XXX XXXX" },
      { "label": "Mobile (090x, 091x, 094x, 095x)", "national": "0905 XXX XXX", "international": "+421 905 XXX XXX" },
      { "label": "Freephone", "national": "0800 XXX XXX", "international": "+421 800 XXX XXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+421212345678", "international": "+421 2 1234 5678", "national": "02/1234 5678", "note": "Bratislava — single-digit area code 2 with an 8-digit subscriber number" },
      { "type": "fixed-line", "e164": "+421551234567", "international": "+421 55 123 4567", "national": "055/123 4567", "note": "Košice — 2-digit area code 55" },
      { "type": "mobile", "e164": "+421905123456", "international": "+421 905 123 456", "national": "0905 123 456", "note": "Mobile — 0905 is a Slovak Telekom range" },
      { "type": "toll-free", "e164": "+421800123456", "international": "+421 800 123 456", "national": "0800 123 456", "note": "Freephone" }
    ],
    "notes": [
      "Slovakia uses a closed 9-digit NSN. Bratislava has a 1-digit area code plus 8-digit subscriber number; everywhere else has a 2-digit area code plus 7 digits.",
      "The slash notation (02/1234 5678) separating area code from subscriber number is a common Slovak and Czech writing convention."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Slovakia",
      "RÚ — číslovací plán: https://www.teleoff.gov.sk/"
    ]
  },
  {
    "iso2": "HU",
    "callingCode": "+36",
    "trunkPrefix": "06",
    "internationalPrefix": "00",
    "nsnLengths": [8, 9],
    "formats": {
      "national": "06 A XXX XXXX (Budapest) / 06 AA XXX XXX (elsewhere)",
      "international": "+36 A XXX XXXX (trunk 06 dropped)"
    },
    "patterns": [
      { "label": "Budapest (area code 1)", "national": "06 1 XXX XXXX", "international": "+36 1 XXX XXXX" },
      { "label": "Other geographic (2-digit area codes)", "national": "06 XX XXX XXX", "international": "+36 XX XXX XXX" },
      { "label": "Mobile (20, 30, 31, 50, 70)", "national": "06 20 XXX XXXX", "international": "+36 20 XXX XXXX" },
      { "label": "Freephone", "national": "06 80 XXX XXX", "international": "+36 80 XXX XXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+3612345678", "international": "+36 1 234 5678", "national": "06 1 234 5678", "note": "Budapest — area code 1, 7-digit subscriber number" },
      { "type": "fixed-line", "e164": "+3652123456", "international": "+36 52 123 456", "national": "06 52 123 456", "note": "Debrecen — 2-digit area code 52, 6-digit subscriber number" },
      { "type": "mobile", "e164": "+36201234567", "international": "+36 20 123 4567", "national": "06 20 123 4567", "note": "Mobile — 20 is a Yettel range; 30 and 70 are also mobile" },
      { "type": "toll-free", "e164": "+3680123456", "international": "+36 80 123 456", "national": "06 80 123 456", "note": "Freephone" }
    ],
    "notes": [
      "Hungary's trunk prefix is the two-digit 06, not a single 0 — an unusual arrangement in Europe.",
      "Budapest numbers have a 1-digit area code and 7-digit subscriber number (NSN 8); everywhere else has a 2-digit area code and 6-digit subscriber number (NSN 8). Mobile NSNs are 9 digits."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Hungary",
      "NMHH — számozási terv: https://nmhh.hu/"
    ]
  },
  {
    "iso2": "RO",
    "callingCode": "+40",
    "trunkPrefix": "0",
    "internationalPrefix": "00",
    "nsnLengths": [9],
    "formats": {
      "national": "0AA XXX XXXX (10 digits including trunk 0)",
      "international": "+40 AA XXX XXXX (trunk 0 dropped)"
    },
    "patterns": [
      { "label": "Bucharest (21, 31)", "national": "021 XXX XXXX", "international": "+40 21 XXX XXXX" },
      { "label": "Other geographic (2xx, 3xx)", "national": "0264 XXX XXX", "international": "+40 264 XXX XXX" },
      { "label": "Mobile (7xx)", "national": "0721 XXX XXX", "international": "+40 721 XXX XXX" },
      { "label": "Freephone", "national": "0800 XXX XXX", "international": "+40 800 XXX XXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+40212345678", "international": "+40 21 234 5678", "national": "021 234 5678", "note": "Bucharest — area code 21" },
      { "type": "fixed-line", "e164": "+40264123456", "international": "+40 264 123 456", "national": "0264 123 456", "note": "Cluj-Napoca — area code 264" },
      { "type": "mobile", "e164": "+40721234567", "international": "+40 721 234 567", "national": "0721 234 567", "note": "Mobile — 072x/073x are Vodafone Romania ranges" },
      { "type": "toll-free", "e164": "+40800123456", "international": "+40 800 123 456", "national": "0800 123 456", "note": "Freephone" }
    ],
    "notes": [
      "Romania requires the full 10-digit national form (trunk 0 + 9-digit NSN) for every domestic call, including local ones.",
      "The digit after the trunk 0 encodes the service: 2–3 geographic, 7 mobile, 8 special/toll-free, 9 premium."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Romania",
      "ANCOM — planul naţional de numerotaţie: https://www.ancom.ro/en/numerotatie_2314"
    ]
  },
