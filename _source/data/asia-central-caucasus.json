  {
    "iso2": "LK",
    "callingCode": "+94",
    "trunkPrefix": "0",
    "internationalPrefix": "00",
    "nsnLengths": [9],
    "formats": {
      "national": "0AA X XXXXXX (fixed) / 0XX XXXXXXX (mobile)",
      "international": "+94 AA X XXXXXX (trunk 0 dropped)"
    },
    "patterns": [
      { "label": "Colombo (011)", "national": "011 X XXXXXX", "international": "+94 11 X XXXXXX" },
      { "label": "Other districts (2-digit area codes)", "national": "0XX X XXXXXX", "international": "+94 XX X XXXXXX" },
      { "label": "Mobile (070–078)", "national": "077 XXXXXXX", "international": "+94 77 XXXXXXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+94112123456", "international": "+94 11 2 123456", "national": "011 2 123456", "note": "Colombo — area code 011; the digit after it identifies the fixed operator (2 = SLT-Mobitel)" },
      { "type": "mobile", "e164": "+94777123456", "international": "+94 77 7123456", "national": "077 7123456", "note": "Mobile — 077 is a Dialog Axiata range" },
      { "type": "mobile", "e164": "+94712345678", "international": "+94 71 2345678", "national": "071 2345678", "note": "Mobile — 071 is an SLT-Mobitel range" }
    ],
    "notes": [
      "Sri Lankan fixed numbers embed an operator digit between the area code and the 6-digit subscriber number.",
      "Mobile operator codes fall in the 070–078 range; the NSN is 9 digits for both fixed and mobile."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Sri_Lanka",
      "TRCSL — Telecommunications Regulatory Commission of Sri Lanka: https://www.trc.gov.lk/"
    ]
  },
  {
    "iso2": "NP",
    "callingCode": "+977",
    "trunkPrefix": "0",
    "internationalPrefix": "00",
    "nsnLengths": [8, 10],
    "formats": {
      "national": "0A XXXXXXX (fixed) / 98X XXX XXXX (mobile)",
      "international": "+977 A XXXXXXX (trunk 0 dropped)"
    },
    "patterns": [
      { "label": "Kathmandu (1)", "national": "01 4XXXXXX", "international": "+977 1 4XXXXXX" },
      { "label": "Other districts (2-digit area codes, e.g. Pokhara 61)", "national": "061 XXXXXX", "international": "+977 61 XXXXXX" },
      { "label": "Mobile (97X, 98X)", "national": "98X XXX XXXX", "international": "+977 98X XXX XXXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+97714441234", "international": "+977 1 444 1234", "national": "01 444 1234", "note": "Kathmandu — area code 1; subscriber numbers begin 4, 5 or 6" },
      { "type": "fixed-line", "e164": "+97761123456", "international": "+977 61 123456", "national": "061 123456", "note": "Pokhara — area code 61" },
      { "type": "mobile", "e164": "+9779841234567", "international": "+977 984 123 4567", "national": "984 123 4567", "note": "Mobile — 98X and 97X ranges; 10-digit NSN dialled without a trunk 0" }
    ],
    "notes": [
      "Geographic numbers take the trunk prefix 0 for domestic long-distance; mobile numbers are dialled as a flat 10 digits with no trunk prefix.",
      "Area codes are 1–2 digits with the subscriber number sized to match, giving an 8-digit fixed NSN and a 10-digit mobile NSN."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Nepal",
      "NTA — Nepal Telecommunications Authority: https://nta.gov.np/"
    ]
  },
