[
  {
    "iso2": "KZ",
    "callingCode": "+7",
    "trunkPrefix": "8",
    "internationalPrefix": "810",
    "nsnLengths": [10],
    "formats": {
      "national": "8 (AAA) XXX XX XX",
      "international": "+7 AAA XXX XX XX"
    },
    "patterns": [
      { "label": "Almaty (727), Astana (717)", "national": "8 (727) XXX XX XX", "international": "+7 727 XXX XX XX" },
      { "label": "Other regions (zone codes 710–729)", "national": "8 (7XX) XXX XX XX", "international": "+7 7XX XXX XX XX" },
      { "label": "Mobile (70X, 77X)", "national": "8 (701) XXX XX XX", "international": "+7 701 XXX XX XX" },
      { "label": "Non-geographic (75X, 76X)", "national": "8 (75X) XXX XX XX", "international": "+7 75X XXX XX XX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+77271234567", "international": "+7 727 123 45 67", "national": "8 (727) 123 45 67", "note": "Almaty — zone code 727" },
      { "type": "fixed-line", "e164": "+77171234567", "international": "+7 717 123 45 67", "national": "8 (717) 123 45 67", "note": "Astana — zone code 717" },
      { "type": "mobile", "e164": "+77011234567", "international": "+7 701 123 45 67", "national": "8 (701) 123 45 67", "note": "Mobile — 70X and 77X ranges" }
    ],
    "notes": [
      "Kazakhstan shares country code +7 with Russia; the two are distinguished by zone code, with Kazakhstan holding 6xx and 7xx blocks.",
      "Kazakhstan planned to adopt its own code (+997) but confirmed continued code-sharing with Russia in a November 2023 agreement.",
      "Trunk prefix 8 and international access 8~10 follow the Soviet-era convention retained across the region.",
      "Geographic zone codes 710–729 were assigned by region under a 2006 agreement with Russia."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Kazakhstan",
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Russia"
    ]
  },
  {
    "iso2": "UZ",
    "callingCode": "+998",
    "trunkPrefix": "",
    "internationalPrefix": "00",
    "nsnLengths": [9],
    "formats": {
      "national": "AA XXX XX XX",
      "international": "+998 AA XXX XX XX"
    },
    "patterns": [
      { "label": "Tashkent (71)", "national": "71 XXX XX XX", "international": "+998 71 XXX XX XX" },
      { "label": "Other regions (2-digit area codes)", "national": "XX XXX XX XX", "international": "+998 XX XXX XX XX" },
      { "label": "Mobile (88, 90, 91, 93, 94, 95, 97, 98, 99)", "national": "90 XXX XX XX", "international": "+998 90 XXX XX XX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+998711234567", "international": "+998 71 123 45 67", "national": "71 123 45 67", "note": "Tashkent — area code 71" },
      { "type": "mobile", "e164": "+998901234567", "international": "+998 90 123 45 67", "national": "90 123 45 67", "note": "Mobile — 90 is a Beeline range" },
      { "type": "mobile", "e164": "+998971234567", "international": "+998 97 123 45 67", "national": "97 123 45 67", "note": "Mobile — 97 range" }
    ],
    "notes": [
      "Uzbekistan uses a closed 9-digit plan: a 2-digit area or operator code plus a 7-digit subscriber number.",
      "The Soviet-era 8~10 international prefix has been replaced by 00."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Uzbekistan",
      "Ministry of Digital Technologies of Uzbekistan: https://digital.uz/"
    ]
  },
  {
    "iso2": "GE",
    "callingCode": "+995",
    "trunkPrefix": "0",
    "internationalPrefix": "00",
    "nsnLengths": [9],
    "formats": {
      "national": "0AA XXX XXXX",
      "international": "+995 AA XXX XXXX (trunk 0 dropped)"
    },
    "patterns": [
      { "label": "Tbilisi (32)", "national": "0 32 2XX XXXX", "international": "+995 32 2XX XXXX" },
      { "label": "Eastern Georgia (3xx), Western Georgia (4xx)", "national": "0 4XX XX XXXX", "international": "+995 4XX XX XXXX" },
      { "label": "Mobile (5XX)", "national": "0 5XX XXX XXX", "international": "+995 5XX XXX XXX" },
      { "label": "Fixed wireless (7XX)", "national": "0 7XX XXX XXX", "international": "+995 7XX XXX XXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+995322123456", "international": "+995 32 212 3456", "national": "0 32 212 3456", "note": "Tbilisi — area code 32; Tbilisi subscriber numbers begin with 2" },
      { "type": "mobile", "e164": "+995595123456", "international": "+995 595 123 456", "national": "0 595 123 456", "note": "Mobile — 595 is a MagtiCom range" },
      { "type": "mobile", "e164": "+995551123456", "international": "+995 551 123 456", "national": "0 551 123 456", "note": "Mobile — all Georgian mobile prefixes begin with 5" }
    ],
    "notes": [
      "Closed 9-digit plan. Geographic numbers begin with 3 (eastern Georgia) or 4 (western Georgia); mobile numbers begin with 5.",
      "A leading 5 was added to all mobile prefixes on 2011-06-20 to separate them cleanly from geographic ranges."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Georgia_(country)",
      "ComCom Georgia — National Communications Commission: https://comcom.ge/"
    ]
  },
  {
    "iso2": "AM",
    "callingCode": "+374",
    "trunkPrefix": "0",
    "internationalPrefix": "00",
    "nsnLengths": [8],
    "formats": {
      "national": "0AA XXXXXX",
      "international": "+374 AA XXXXXX (trunk 0 dropped)"
    },
    "patterns": [
      { "label": "Yerevan (10, 11, 12, 15)", "national": "0 10 XXXXXX", "international": "+374 10 XXXXXX" },
      { "label": "Other regions (2-digit destination codes)", "national": "0 XX XXXXXX", "international": "+374 XX XXXXXX" },
      { "label": "Mobile (91, 93, 94, 95, 96, 98, 99, 77)", "national": "0 91 XXXXXX", "international": "+374 91 XXXXXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+37410123456", "international": "+374 10 123456", "national": "0 10 123456", "note": "Yerevan — destination codes 10, 11, 12 and 15" },
      { "type": "mobile", "e164": "+37491123456", "international": "+374 91 123456", "national": "0 91 123456", "note": "Mobile — 91, 93, 95, 96 and 99 are Team/Viva ranges" },
      { "type": "mobile", "e164": "+37477123456", "international": "+374 77 123456", "national": "0 77 123456", "note": "Mobile — 77 range" }
    ],
    "notes": [
      "Closed 8-digit plan: a 2-digit destination code plus a 6-digit subscriber number.",
      "The trunk prefix 0 is used domestically and dropped when dialling from abroad."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Armenia",
      "PSRC — Public Services Regulatory Commission of Armenia: https://psrc.am/"
    ]
  },
