[
  {
    "iso2": "CN",
    "callingCode": "+86",
    "trunkPrefix": "0",
    "internationalPrefix": "00",
    "nsnLengths": [],
    "formats": {
      "national": "0AA-XXXXXXXX (landline) / 1XX-XXXX-XXXX (mobile)",
      "international": "+86 AA XXXXXXXX (trunk 0 dropped)"
    },
    "patterns": [
      { "label": "Beijing (10), Shanghai (21) — 2-digit area codes", "national": "010-XXXXXXXX", "international": "+86 10 XXXXXXXX" },
      { "label": "Other cities — 3-digit area codes", "national": "0XXX-XXXXXXX", "international": "+86 XXX XXXXXXX" },
      { "label": "Mobile (11 digits, always begins with 1)", "national": "1XX XXXX XXXX", "international": "+86 1XX XXXX XXXX" },
      { "label": "Service numbers", "national": "400-XXX-XXXX / 800-XXX-XXXX", "international": "+86 400 XXX XXXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+861012345678", "international": "+86 10 1234 5678", "national": "010-12345678", "note": "Beijing — 2-digit area code 10" },
      { "type": "fixed-line", "e164": "+862112345678", "international": "+86 21 1234 5678", "national": "021-12345678", "note": "Shanghai — 2-digit area code 21" },
      { "type": "mobile", "e164": "+8613812345678", "international": "+86 138 1234 5678", "national": "138 1234 5678", "note": "Mobile — always 11 digits beginning with 1; 138 is a China Mobile range" },
      { "type": "toll-free", "e164": "+864001234567", "international": "+86 400 123 4567", "national": "400-123-4567", "note": "Shared-cost service number; 800 is the true freephone range" }
    ],
    "notes": [
      "Landlines carry area codes (2 digits for the largest cities, 3 elsewhere) but mobile numbers do not — a mobile number is always a flat 11 digits starting with 1.",
      "Because landline NSN length varies with area-code length, length alone cannot validate a Chinese number.",
      "400 numbers are shared-cost (the caller pays a local rate); 800 numbers are true freephone but are often unreachable from mobiles."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_China",
      "MIIT — Ministry of Industry and Information Technology: https://www.miit.gov.cn/"
    ]
  },
  {
    "iso2": "JP",
    "callingCode": "+81",
    "trunkPrefix": "0",
    "internationalPrefix": "010",
    "nsnLengths": [9, 10],
    "formats": {
      "national": "0A-XXXX-XXXX (major cities) / 0AAAA-XX-XXXX (rural)",
      "international": "+81 A XXXX XXXX (trunk 0 dropped)"
    },
    "patterns": [
      { "label": "Tokyo (03), Osaka (06)", "national": "03-XXXX-XXXX", "international": "+81 3 XXXX XXXX" },
      { "label": "Regional (2–5 digit area codes)", "national": "0XX-XXX-XXXX", "international": "+81 XX XXX XXXX" },
      { "label": "Mobile (070, 080, 090)", "national": "090-XXXX-XXXX", "international": "+81 90 XXXX XXXX" },
      { "label": "Toll-free (free dial)", "national": "0120-XXX-XXX", "international": "+81 120 XXX XXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+81312345678", "international": "+81 3 1234 5678", "national": "03-1234-5678", "note": "Tokyo — area code 3, the shortest in Japan" },
      { "type": "fixed-line", "e164": "+81612345678", "international": "+81 6 1234 5678", "national": "06-1234-5678", "note": "Osaka — area code 6" },
      { "type": "mobile", "e164": "+819012345678", "international": "+81 90 1234 5678", "national": "090-1234-5678", "note": "Mobile — 070, 080 and 090 are the mobile prefixes" },
      { "type": "toll-free", "e164": "+81120123456", "international": "+81 120 123 456", "national": "0120-123-456", "note": "Free dial (フリーダイヤル)" }
    ],
    "notes": [
      "Japan's international access prefix is 010, not 00.",
      "Area code length is inversely proportional to population density: Tokyo is a single digit (3), while rural areas run to five digits. The subscriber number shrinks to compensate.",
      "Area codes increase roughly north to south — Sapporo 11, Kagoshima 99.",
      "Numbers are conventionally written with hyphens."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Japan",
      "MIC — Ministry of Internal Affairs and Communications: https://www.soumu.go.jp/main_sosiki/joho_tsusin/top/tel_number/"
    ]
  },
  {
    "iso2": "KR",
    "callingCode": "+82",
    "trunkPrefix": "0",
    "internationalPrefix": "00X (carrier-selected, e.g. 001, 002, 00700)",
    "nsnLengths": [8, 9, 10],
    "formats": {
      "national": "0A-XXX-XXXX (Seoul) / 0AA-XXX-XXXX (elsewhere)",
      "international": "+82 A XXX XXXX (trunk 0 dropped)"
    },
    "patterns": [
      { "label": "Seoul (02)", "national": "02-XXX-XXXX", "international": "+82 2 XXX XXXX" },
      { "label": "Busan (051), Incheon (032), Daegu (053)", "national": "051-XXX-XXXX", "international": "+82 51 XXX XXXX" },
      { "label": "Mobile (010)", "national": "010-XXXX-XXXX", "international": "+82 10 XXXX XXXX" },
      { "label": "Nationwide single number", "national": "1577-XXXX", "international": "+82 1577 XXXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+8223123456", "international": "+82 2 312 3456", "national": "02-312-3456", "note": "Seoul — area code 02, the only single-digit code" },
      { "type": "fixed-line", "e164": "+82511234567", "international": "+82 51 123 4567", "national": "051-123-4567", "note": "Busan — area code 051" },
      { "type": "mobile", "e164": "+821012345678", "international": "+82 10 1234 5678", "national": "010-1234-5678", "note": "Mobile — since 2004-01-01 all South Korean mobiles use the single 010 prefix" }
    ],
    "notes": [
      "Since 2004 every South Korean mobile number uses the 010 prefix regardless of carrier, replacing the old per-operator prefixes (011, 016, 017, 018, 019).",
      "The international access prefix is carrier-selected — 001, 002, 00700 and others all work and are billed differently.",
      "Seoul has the single-digit area code 2; other regions have two digits."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_South_Korea",
      "KCC — Korea Communications Commission: https://www.kcc.go.kr/"
    ]
  },
  {
    "iso2": "IN",
    "callingCode": "+91",
    "trunkPrefix": "0",
    "internationalPrefix": "00",
    "nsnLengths": [10],
    "formats": {
      "national": "0AA-XXXX-XXXX (STD code + subscriber number, 10 digits total)",
      "international": "+91 AA XXXX XXXX (trunk 0 dropped)"
    },
    "patterns": [
      { "label": "Metro STD codes — Delhi (11), Mumbai (22), Kolkata (33), Chennai (44)", "national": "011-XXXX-XXXX", "international": "+91 11 XXXX XXXX" },
      { "label": "Second-tier cities — Jaipur (141), Lucknow (522)", "national": "0141-XXX-XXXX", "international": "+91 141 XXX XXXX" },
      { "label": "Mobile (starts 6, 7, 8 or 9)", "national": "9XXXX XXXXX", "international": "+91 9XXXX XXXXX" },
      { "label": "Toll-free", "national": "1800-XXX-XXXX", "international": "+91 1800 XXX XXXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+911123456789", "international": "+91 11 2345 6789", "national": "011-2345-6789", "note": "Delhi — STD code 11" },
      { "type": "fixed-line", "e164": "+912223456789", "international": "+91 22 2345 6789", "national": "022-2345-6789", "note": "Mumbai — STD code 22" },
      { "type": "mobile", "e164": "+919812345678", "international": "+91 98123 45678", "national": "98123 45678", "note": "Mobile — 10 digits beginning 6, 7, 8 or 9; operator-independent since number portability" },
      { "type": "fixed-line", "e164": "+911412345678", "international": "+91 141 234 5678", "national": "0141-234-5678", "note": "Jaipur — 3-digit STD code 141" }
    ],
    "notes": [
      "India runs a closed 10-digit plan: the STD (area) code plus subscriber number always totals 10 digits, so a 2-digit metro code leaves 8 subscriber digits while an 8-digit rural code leaves 2.",
      "Mobile numbers are 10 digits beginning with 6, 7, 8 or 9 and carry no area code.",
      "Governed by the National Numbering Plan 2003 under the Department of Telecommunications."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_India",
      "DoT — National Numbering Plan: https://dot.gov.in/"
    ]
  },
  {
