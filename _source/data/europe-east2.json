[
  {
    "iso2": "RU",
    "callingCode": "+7",
    "trunkPrefix": "8",
    "internationalPrefix": "810",
    "nsnLengths": [10],
    "formats": {
      "national": "8 AAA XXX-XX-XX",
      "international": "+7 AAA XXX XX XX"
    },
    "patterns": [
      { "label": "Moscow (495, 499)", "national": "8 495 XXX-XX-XX", "international": "+7 495 XXX XX XX" },
      { "label": "Saint Petersburg (812)", "national": "8 812 XXX-XX-XX", "international": "+7 812 XXX XX XX" },
      { "label": "Mobile (9XX)", "national": "8 985 XXX-XX-XX", "international": "+7 985 XXX XX XX" },
      { "label": "Freephone", "national": "8 800 XXX-XX-XX", "international": "+7 800 XXX XX XX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+74951234567", "international": "+7 495 123 45 67", "national": "8 495 123-45-67", "note": "Moscow — area code 495 (499 is the overlay)" },
      { "type": "fixed-line", "e164": "+78121234567", "international": "+7 812 123 45 67", "national": "8 812 123-45-67", "note": "Saint Petersburg — area code 812" },
      { "type": "mobile", "e164": "+79851234567", "international": "+7 985 123 45 67", "national": "8 985 123-45-67", "note": "Mobile — all Russian mobile codes begin with 9" },
      { "type": "toll-free", "e164": "+78001234567", "international": "+7 800 123 45 67", "national": "8 800 123-45-67", "note": "Freephone" }
    ],
    "notes": [
      "Russia shares country code +7 with Kazakhstan — the code alone does not identify the country.",
      "The trunk prefix is 8 (not 0) and the international access code is 8~10, dialled as 8 then 10 after a second dial tone.",
      "Closed plan: NSN is always 10 digits (3-digit area code + 7-digit subscriber number).",
      "All mobile area codes begin with 9, which is the reliable way to distinguish mobile from fixed."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Russia",
      "Ministry of Digital Development — Russian numbering plan: https://digital.gov.ru/"
    ]
  },
  {
    "iso2": "EE",
    "callingCode": "+372",
    "trunkPrefix": "",
    "internationalPrefix": "00",
    "nsnLengths": [7, 8],
    "formats": {
      "national": "XXX XXXX (fixed) / XXXX XXXX (mobile)",
      "international": "+372 XXX XXXX"
    },
    "patterns": [
      { "label": "Fixed line (3xx–7xx)", "national": "XXX XXXX", "international": "+372 XXX XXXX" },
      { "label": "Mobile (5xxx)", "national": "5XXX XXXX", "international": "+372 5XXX XXXX" },
      { "label": "Freephone", "national": "800 XXXX", "international": "+372 800 XXXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+3727992222", "international": "+372 799 2222", "national": "799 2222", "note": "Tallinn — fixed lines are 7 digits" },
      { "type": "mobile", "e164": "+37251234567", "international": "+372 5123 4567", "national": "5123 4567", "note": "Mobile — all Estonian mobiles begin with 5" },
      { "type": "fixed-line", "e164": "+3723441234", "international": "+372 344 1234", "national": "344 1234", "note": "Narva region fixed line" }
    ],
    "notes": [
      "Estonia moved to a closed plan on 2003-05-01, abolishing area codes and the trunk prefix; every call within Estonia is dialled as a plain local number.",
      "Fixed lines are 7 digits; mobile numbers are 7 or 8 digits and always start with 5."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Estonia",
      "Estonian Consumer Protection and Technical Regulatory Authority: https://ttja.ee/"
    ]
  },
  {
    "iso2": "LV",
    "callingCode": "+371",
    "trunkPrefix": "",
    "internationalPrefix": "00",
    "nsnLengths": [8],
    "formats": {
      "national": "XX XXX XXX",
      "international": "+371 XX XXX XXX"
    },
    "patterns": [
      { "label": "Fixed line (6xxxxxxx; 67x = Riga)", "national": "67 XXX XXX", "international": "+371 67 XXX XXX" },
      { "label": "Mobile (2xxxxxxx)", "national": "2X XXX XXX", "international": "+371 2X XXX XXX" },
      { "label": "Freephone", "national": "80 XXX XXX", "international": "+371 80 XXX XXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+37167123456", "international": "+371 67 123 456", "national": "67 123 456", "note": "Riga — the 67x block serves the Riga district" },
      { "type": "mobile", "e164": "+37121234567", "international": "+371 21 234 567", "national": "21 234 567", "note": "Mobile — all Latvian mobiles begin with 2" },
      { "type": "toll-free", "e164": "+37180123456", "international": "+371 80 123 456", "national": "80 123 456", "note": "Freephone" }
    ],
    "notes": [
      "Latvia uses a closed 8-digit plan with no trunk prefix or separately dialled area codes.",
      "All fixed lines begin with 6 and all mobiles with 2 — a reform completed in 2008."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Latvia",
      "SPRK — Public Utilities Commission: https://www.sprk.gov.lv/"
    ]
  },
  {
    "iso2": "LT",
    "callingCode": "+370",
    "trunkPrefix": "0",
    "internationalPrefix": "00",
    "nsnLengths": [8],
    "formats": {
      "national": "(0 A) XXX XXXX / (0 AAA) XXXXX",
      "international": "+370 A XXX XXXX (trunk 0 dropped)"
    },
    "patterns": [
      { "label": "Vilnius (5)", "national": "(0 5) XXX XXXX", "international": "+370 5 XXX XXXX" },
      { "label": "Kaunas (37), Klaipėda (46)", "national": "(0 37) XX XXXX", "international": "+370 37 XX XXXX" },
      { "label": "Mobile (6XX)", "national": "(0 6XX) XXXXX", "international": "+370 6XX XXXXX" },
      { "label": "Freephone", "national": "(0 800) XXXXX", "international": "+370 800 XXXXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+37051234567", "international": "+370 5 123 4567", "national": "(0 5) 123 4567", "note": "Vilnius — area code 5" },
      { "type": "fixed-line", "e164": "+37037123456", "international": "+370 37 123 456", "national": "(0 37) 123 456", "note": "Kaunas — area code 37" },
      { "type": "mobile", "e164": "+37061234567", "international": "+370 612 34567", "national": "(0 612) 34567", "note": "Mobile — all Lithuanian mobiles begin with 6" }
    ],
    "notes": [
      "Lithuania replaced the legacy trunk prefix 8 with 0 on 2024-03-01, aligning with the rest of the EU.",
      "Open plan: the area code is 1–3 digits and the subscriber number 5–7, with NSN always totalling 8 digits."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Lithuania",
      "RRT — Communications Regulatory Authority: https://www.rrt.lt/"
    ]
  },
  {
    "iso2": "TR",
    "callingCode": "+90",
    "trunkPrefix": "0",
    "internationalPrefix": "00",
    "nsnLengths": [10],
    "formats": {
      "national": "0 (AAA) XXX XX XX",
      "international": "+90 AAA XXX XX XX (trunk 0 dropped)"
    },
    "patterns": [
      { "label": "Istanbul — European side (212), Asian side (216)", "national": "0212 XXX XX XX", "international": "+90 212 XXX XX XX" },
      { "label": "Ankara (312), İzmir (232)", "national": "0312 XXX XX XX", "international": "+90 312 XXX XX XX" },
      { "label": "Mobile (5XX)", "national": "0530 XXX XX XX", "international": "+90 530 XXX XX XX" },
      { "label": "Freephone", "national": "0800 XXX XX XX", "international": "+90 800 XXX XX XX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+902121234567", "international": "+90 212 123 45 67", "national": "0212 123 45 67", "note": "Istanbul, European side — area code 212" },
      { "type": "fixed-line", "e164": "+903121234567", "international": "+90 312 123 45 67", "national": "0312 123 45 67", "note": "Ankara — area code 312" },
      { "type": "mobile", "e164": "+905301234567", "international": "+90 530 123 45 67", "national": "0530 123 45 67", "note": "Mobile — 530–539 are Turkcell ranges; all mobiles begin with 5" },
      { "type": "toll-free", "e164": "+908001234567", "international": "+90 800 123 45 67", "national": "0800 123 45 67", "note": "Freephone" }
    ],
    "notes": [
      "Closed plan: every province has a 3-digit area code and a 7-digit local number, giving a uniform 10-digit NSN.",
      "Istanbul is the only province with two area codes — 212 for the European side and 216 for the Asian side.",
      "Northern Cyprus is integrated into the Turkish plan as +90 392."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Turkey",
      "BTK — Information and Communication Technologies Authority: https://www.btk.gov.tr/"
    ]
  },
  {
