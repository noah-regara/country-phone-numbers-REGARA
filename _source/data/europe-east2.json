    "callingCode": "+357",
    "trunkPrefix": "",
    "internationalPrefix": "00",
    "nsnLengths": [8],
    "formats": {
      "national": "XX XXXXXX",
      "international": "+357 XX XXXXXX"
    },
    "patterns": [
      { "label": "Nicosia (22), Limassol (25), Larnaca (24), Paphos (26)", "national": "22 XXXXXX", "international": "+357 22 XXXXXX" },
      { "label": "Mobile (9X)", "national": "9X XXXXXX", "international": "+357 9X XXXXXX" },
      { "label": "Freephone", "national": "800 XXXXX", "international": "+357 800 XXXXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+35722123456", "international": "+357 22 123456", "national": "22 123456", "note": "Nicosia — district code 22" },
      { "type": "fixed-line", "e164": "+35725123456", "international": "+357 25 123456", "national": "25 123456", "note": "Limassol — district code 25" },
      { "type": "mobile", "e164": "+35796123456", "international": "+357 96 123456", "national": "96 123456", "note": "Mobile — 9x; the second digit identifies the carrier (7 CYTA, 6 Epic, 5 PrimeTel, 4 Cablenet)" }
    ],
    "notes": [
      "Cyprus uses a closed 8-digit plan with no trunk prefix; district codes are dialled as part of the number.",
      "Northern Cyprus is not covered by +357: it is integrated into the Turkish numbering plan and reached as +90 392."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Cyprus",
      "OCECPR — Office of the Commissioner of Electronic Communications: https://www.ocecpr.org.cy/"
    ]
  },
  {
    "iso2": "MX",
    "callingCode": "+52",
    "trunkPrefix": "",
    "internationalPrefix": "00",
    "nsnLengths": [10],
    "formats": {
      "national": "AA XXXX XXXX (2-digit area code) / AAA XXX XXXX (3-digit area code)",
      "international": "+52 AA XXXX XXXX"
    },
    "patterns": [
      { "label": "Mexico City (55), Monterrey (81), Guadalajara (33)", "national": "55 XXXX XXXX", "international": "+52 55 XXXX XXXX" },
      { "label": "Other cities (3-digit area codes)", "national": "XXX XXX XXXX", "international": "+52 XXX XXX XXXX" },
      { "label": "Toll-free", "national": "800 XXX XXXX", "international": "+52 800 XXX XXXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+525512345678", "international": "+52 55 1234 5678", "national": "55 1234 5678", "note": "Mexico City — area code 55" },
      { "type": "fixed-line", "e164": "+523312345678", "international": "+52 33 1234 5678", "national": "33 1234 5678", "note": "Guadalajara — area code 33" },
      { "type": "mobile", "e164": "+525598765432", "international": "+52 55 9876 5432", "national": "55 9876 5432", "note": "Mobile — since the 2019 reform mobiles share geographic area codes and are indistinguishable by format" },
      { "type": "toll-free", "e164": "+528001234567", "international": "+52 800 123 4567", "national": "800 123 4567", "note": "Toll-free" }
    ],
    "notes": [
      "Mexico reformed its plan on 2019-08-03: all calls now use a uniform 10-digit number and the old prefixes 01 (long distance), 044 and 045 (mobile) were abolished.",
      "Since the reform, mobile and fixed numbers are drawn from the same area codes and cannot be told apart by format alone — the +521 mobile prefix once required from abroad is also obsolete.",
      "The first digit of the area code indicates a broad region: 2 East, 3 West, 4 North, 5 Centre, 6 Northwest, 7 South, 8 Northeast, 9 Southeast."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Mexico",
      "IFT — Instituto Federal de Telecomunicaciones: https://www.ift.org.mx/"
    ]
  }
