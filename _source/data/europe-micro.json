[
  {
    "iso2": "IS",
    "callingCode": "+354",
    "trunkPrefix": "",
    "internationalPrefix": "00",
    "nsnLengths": [7, 9],
    "formats": {
      "national": "XXX XXXX",
      "international": "+354 XXX XXXX"
    },
    "patterns": [
      { "label": "Fixed line (Capital Region 5xx, regional 4xx)", "national": "5XX XXXX", "international": "+354 5XX XXXX" },
      { "label": "Mobile (6xx, 7xx, 8xx)", "national": "8XX XXXX", "international": "+354 8XX XXXX" },
      { "label": "Freephone", "national": "800 XXXX", "international": "+354 800 XXXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+3545512345", "international": "+354 551 2345", "national": "551 2345", "note": "Reykjavík — 5xx is the Capital Region fixed range" },
      { "type": "mobile", "e164": "+3548215678", "international": "+354 821 5678", "national": "821 5678", "note": "Mobile — 6xx/7xx/8xx ranges" },
      { "type": "toll-free", "e164": "+3548001234", "international": "+354 800 1234", "national": "800 1234", "note": "Freephone" }
    ],
    "notes": [
      "Iceland uses a closed 7-digit plan with no trunk prefix or area codes; numbers beginning with 3 are 9 digits.",
      "Number portability means the leading digits no longer reliably indicate operator or region."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Iceland",
      "Electronic Communications Office of Iceland (Fjarskiptastofa): https://www.fjarskiptastofa.is/"
    ]
  },
  {
    "iso2": "LU",
    "callingCode": "+352",
    "trunkPrefix": "",
    "internationalPrefix": "00",
    "nsnLengths": [],
    "formats": {
      "national": "XX XX XX (variable length, closed dialling)",
      "international": "+352 XX XX XX"
    },
    "patterns": [
      { "label": "Fixed line (legacy short form)", "national": "XX XXXX", "international": "+352 XX XXXX" },
      { "label": "Fixed line (Luxembourg City 4xxxxx)", "national": "4X XX XX", "international": "+352 4X XX XX" },
      { "label": "Mobile (621, 661, 691…)", "national": "6X1 XXX XXX", "international": "+352 6X1 XXX XXX" },
      { "label": "Freephone", "national": "800 XXXXX", "international": "+352 800 XXXXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+3524123456", "international": "+352 4 123 456", "national": "4 123 456", "note": "Luxembourg City fixed line" },
      { "type": "fixed-line", "e164": "+35226791234", "international": "+352 2679 1234", "national": "2679 1234", "note": "Consdorf — 8-digit form introduced in 2000" },
      { "type": "mobile", "e164": "+352661234567", "international": "+352 661 234 567", "national": "661 234 567", "note": "Mobile — 661 is an Orange range" },
      { "type": "toll-free", "e164": "+35280012345", "international": "+352 800 12345", "national": "800 12345", "note": "Freephone" }
    ],
    "notes": [
      "Luxembourg uses a closed dialling system: numbers are dialled identically from inside and outside the country (minus the country code), with no trunk prefix.",
      "Fixed-line NSNs are genuinely variable — historically 6 digits, extended to 7–8 — so length-based validation is unreliable. Mobile NSNs are 9 digits."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Luxembourg"
    ]
  },
  {
