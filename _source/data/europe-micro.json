    "examples": [
      { "type": "fixed-line", "e164": "+35621234567", "international": "+356 2123 4567", "national": "2123 4567", "note": "Fixed line — 21 is a GO range" },
      { "type": "mobile", "e164": "+35699234567", "international": "+356 9923 4567", "national": "9923 4567", "note": "Mobile — 99 range (replaced the old 09 prefix in 2002)" },
      { "type": "mobile", "e164": "+35679123456", "international": "+356 7912 3456", "national": "7912 3456", "note": "Mobile — 79 range" }
    ],
    "notes": [
      "Malta runs a closed 8-digit plan with no trunk prefix or area codes; numbers are conventionally written as two groups of four.",
