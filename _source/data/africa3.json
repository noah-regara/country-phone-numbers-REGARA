  {
    "iso2": "SD",
    "callingCode": "+249",
    "trunkPrefix": "0",
    "internationalPrefix": "00",
    "nsnLengths": [9],
    "formats": {
      "national": "0TP AXX XXXX (T = service type, P = provider)",
      "international": "+249 TP AXX XXXX (trunk 0 dropped)"
    },
    "patterns": [
      { "label": "Fixed — Sudani (10, 11, 12), Canar (15), Sudatel (18)", "national": "013 XXX XXXX", "international": "+249 13 XXX XXXX" },
      { "label": "Mobile — Zain (90, 91, 96), MTN (92, 93, 99), NOW (95)", "national": "092 XXX XXXX", "international": "+249 92 XXX XXXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+249131234567", "international": "+249 13 123 4567", "national": "013 123 4567", "note": "Khartoum — Sudani fixed line; 1 denotes fixed service, 3 the Khartoum area" },
      { "type": "mobile", "e164": "+249921234567", "international": "+249 92 123 4567", "national": "092 123 4567", "note": "Mobile — 92/93/99 are MTN Sudan ranges" },
      { "type": "mobile", "e164": "+249911234567", "international": "+249 91 123 4567", "national": "091 123 4567", "note": "Mobile — 90/91/96 are Zain Sudan ranges" }
    ],
    "notes": [
      "Sudanese numbers encode service type in the first digit after the trunk 0 (1 = fixed, 9 = mobile) and the provider in the second.",
      "South Sudan used +249 until 2011-10-01, when it moved to its own code +211."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Sudan",
      "TPRA — Telecommunication and Post Regulatory Authority of Sudan: https://tpra.gov.sd/"
    ]
  },
  {
    "iso2": "SS",
    "callingCode": "+211",
    "trunkPrefix": "",
    "internationalPrefix": "00",
    "nsnLengths": [9],
    "formats": {
      "national": "MM NNN NNNN",
      "international": "+211 MM NNN NNNN"
    },
    "patterns": [
      { "label": "Fixed — Sudani CDMA (12), Sudani landline (18)", "national": "18 NNN NNNN", "international": "+211 18 NNN NNNN" },
      { "label": "Mobile — Zain (91), MTN (92), Digitel (98)", "national": "91 NNN NNNN", "international": "+211 91 NNN NNNN" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+211181111111", "international": "+211 18 111 1111", "national": "18 111 1111", "note": "Juba — Sudani fixed service, prefix 18" },
      { "type": "mobile", "e164": "+211915555555", "international": "+211 91 555 5555", "national": "91 555 5555", "note": "Mobile — 91 is a Zain South Sudan range" },
      { "type": "mobile", "e164": "+211921234567", "international": "+211 92 123 4567", "national": "92 123 4567", "note": "Mobile — 92 is an MTN South Sudan range" }
    ],
    "notes": [
      "South Sudan continued using Sudan's +249 after independence on 2011-07-09 and switched to its own code +211 on 2011-10-01.",
      "The NSN is 9 digits: a 2-digit operator code plus a 7-digit subscriber number."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_South_Sudan",
      "National Communication Authority of South Sudan: https://nca.gov.ss/"
    ]
  },
  {
    "iso2": "RW",
    "callingCode": "+250",
    "trunkPrefix": "0",
    "internationalPrefix": "00",
    "nsnLengths": [9],
    "formats": {
      "national": "0NNN XXX XXX",
      "international": "+250 NNN XXX XXX"
    },
    "patterns": [
      { "label": "Fixed line (25X)", "national": "0250 XXX XXX", "international": "+250 250 XXX XXX" },
      { "label": "Mobile — MTN (078, 079), Airtel (073, 072)", "national": "0788 XXX XXX", "international": "+250 788 XXX XXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+250250512345", "international": "+250 250 512 345", "national": "0250 512 345", "note": "Kigali — geographic landlines begin with 25" },
      { "type": "mobile", "e164": "+250788123456", "international": "+250 788 123 456", "national": "0788 123 456", "note": "Mobile — 78 is an MTN Rwanda range" },
      { "type": "mobile", "e164": "+250730123456", "international": "+250 730 123 456", "national": "0730 123 456", "note": "Mobile — 73 range" }
    ],
    "notes": [
      "The Rwanda Utilities Regulatory Authority introduced the current numbering plan in February 2009.",
      "The NSN is 9 digits: a 3-digit national destination code plus a 6-digit subscriber number.",
      "Mobile prefixes are 72, 73 and 78; geographic landlines begin 25."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Rwanda",
      "RURA — Rwanda Utilities Regulatory Authority: https://rura.rw/"
    ]
  },
  {
    "iso2": "CD",
    "callingCode": "+243",
    "trunkPrefix": "0",
    "internationalPrefix": "00",
    "nsnLengths": [],
    "formats": {
      "national": "0A XXX XX XX (landline) / 0AA XXX XX XX (mobile)",
      "international": "+243 A XXX XX XX (trunk 0 dropped)"
    },
    "patterns": [
      { "label": "Kinshasa (1)", "national": "01 XXX XX XX", "international": "+243 1 XXX XX XX" },
      { "label": "Katanga (2), Bas-Congo/Bandundu (3), Kasaï (4), Orientale (5), Kivu (6)", "national": "0X XXX XX XX", "international": "+243 X XXX XX XX" },
      { "label": "Mobile (81, 82, 84, 85, 89, 90, 97, 99)", "national": "082 XXX XX XX", "international": "+243 82 XXX XX XX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+24312345678", "international": "+243 1 234 56 78", "national": "01 234 56 78", "note": "Kinshasa — area code 1" },
      { "type": "mobile", "e164": "+243821234567", "international": "+243 82 123 45 67", "national": "082 123 45 67", "note": "Mobile — 82 is a Vodacom Congo range" },
      { "type": "mobile", "e164": "+243991234567", "international": "+243 99 123 45 67", "national": "099 123 45 67", "note": "Mobile — 99 range" }
    ],
    "notes": [
      "Landline area codes are single digits mapping to former provinces; mobile prefixes are two digits.",
      "Fixed-line infrastructure is limited and mobile numbers dominate in practice.",
      "NSN length varies between fixed (8) and mobile (9), so length alone is a weak validator."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_the_Democratic_Republic_of_the_Congo",
      "ARPTC — Autorité de Régulation de la Poste et des Télécommunications du Congo: https://www.arptc.gouv.cd/"
    ]
  },
