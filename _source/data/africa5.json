    ],
    "examples": [
      { "type": "fixed-line", "e164": "+2290121301234", "international": "+229 01 21 30 1234", "national": "01 21 30 1234", "note": "Cotonou — 21 is the Littoral/Atlantique code, 30 the Cadjehoun district" },
      { "type": "mobile", "e164": "+2290150123456", "international": "+229 01 50 12 3456", "national": "01 50 12 3456", "note": "Mobile — the 50–59 block is MTN Benin" }
    ],
    "notes": [
      "On 2024-11-30 Benin prefixed '01' to every number, taking the NSN from 8 to 10 digits. Older 8-digit Beninese numbers are no longer valid.",
