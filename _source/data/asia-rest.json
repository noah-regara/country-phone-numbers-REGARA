    "patterns": [
      { "label": "Sanaa (01)", "national": "01 XXXXXXX", "international": "+967 1 XXXXXXX" },
      { "label": "Aden (02), Taiz (04), other governorates", "national": "0X XXXXXX", "international": "+967 X XXXXXX" },
      { "label": "Mobile — Sabafon (71), MTN/Yemen Mobile (73, 77, 70)", "national": "71 XXXXXXX", "international": "+967 71 XXXXXXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+96712345678", "international": "+967 1 234 5678", "national": "01 234 5678", "note": "Sanaa — area code 01" },
      { "type": "fixed-line", "e164": "+9672234567", "international": "+967 2 234567", "national": "02 234567", "note": "Aden — area code 2 with a 6-digit subscriber number, giving the usual 7-digit governorate NSN" },
      { "type": "mobile", "e164": "+967711234567", "international": "+967 71 123 4567", "national": "71 123 4567", "note": "Mobile — 71 is a Sabafon range; mobile numbers carry no trunk 0" }
    ],
    "notes": [
      "The trunk prefix 0 applies to landlines only; mobile numbers are dialled without it.",
