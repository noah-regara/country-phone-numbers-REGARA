  {
    "iso2": "LB",
    "callingCode": "+961",
    "trunkPrefix": "0",
    "internationalPrefix": "00",
    "nsnLengths": [7, 8],
    "formats": {
      "national": "0A XXX XXX (landline) / 0AA XXX XXX (mobile)",
      "international": "+961 A XXX XXX (trunk 0 dropped)"
    },
    "patterns": [
      { "label": "Beirut (01)", "national": "01 XXX XXX", "international": "+961 1 XXX XXX" },
      { "label": "Other regions (04 Metn, 05 Aley, 06 Tripoli, 07 South, 08 Bekaa, 09 Keserwan)", "national": "0X XXX XXX", "international": "+961 X XXX XXX" },
      { "label": "Mobile — Alfa (03, 071, 076, 078, 079), touch (03, 070, 081)", "national": "071 XXX XXX", "international": "+961 71 XXX XXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+9611123456", "international": "+961 1 123 456", "national": "01 123 456", "note": "Beirut — area code 01 covers the city and its metropolitan area" },
      { "type": "mobile", "e164": "+96171123456", "international": "+961 71 123 456", "national": "071 123 456", "note": "Mobile — 071 is an Alfa (MIC1) range" },
      { "type": "mobile", "e164": "+96170123456", "international": "+961 70 123 456", "national": "070 123 456", "note": "Mobile — 070 is a touch (MIC2) range" }
    ],
    "notes": [
      "Landline NSNs are 7 digits and mobile NSNs 8, so length distinguishes the two.",
      "The two mobile operators are known by their licence names MIC1 (Alfa) and MIC2 (touch)."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Lebanon",
      "TRA Lebanon — Telecommunications Regulatory Authority: https://www.tra.gov.lb/"
    ]
  },
  {
    "iso2": "PS",
    "callingCode": "+970",
    "additionalCallingCodes": ["+972"],
    "trunkPrefix": "0",
    "internationalPrefix": "00",
    "nsnLengths": [8, 9],
    "formats": {
      "national": "0A XXX XXXX (landline) / 05X XXX XXXX (mobile)",
      "international": "+970 A XXX XXXX — often also reachable as +972 A XXX XXXX"
    },
    "patterns": [
      { "label": "West Bank — Ramallah/Jerusalem (02), Nablus (09), Hebron (02)", "national": "02 XXX XXXX", "international": "+970 2 XXX XXXX" },
      { "label": "Gaza Strip (08)", "national": "08 XXX XXXX", "international": "+970 8 XXX XXXX" },
      { "label": "Mobile — Jawwal (059), Ooredoo (056)", "national": "059 XXX XXXX", "international": "+970 59 XXX XXXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+97022951234", "international": "+970 2 295 1234", "national": "02 295 1234", "note": "Ramallah, West Bank — area code 02" },
      { "type": "fixed-line", "e164": "+97082821234", "international": "+970 8 282 1234", "national": "08 282 1234", "note": "Gaza City — area code 08" },
      { "type": "mobile", "e164": "+970599123456", "international": "+970 59 912 3456", "national": "059 912 3456", "note": "Mobile — 059 is a Jawwal range" }
    ],
    "notes": [
      "Palestine holds country code +970, but because the network depends heavily on Israeli infrastructure many Palestinian numbers are also reachable via +972 — and from some countries +972 routes more reliably.",
      "Any system validating Palestinian numbers should accept both +970 and +972 forms.",
      "Area code 02 spans Ramallah, Jerusalem and Hebron; 08 covers the Gaza Strip; 09 covers Nablus and the northern West Bank."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_the_State_of_Palestine",
      "Palestinian Ministry of Telecommunications and Digital Economy: https://www.mtit.pna.ps/"
    ]
  },
