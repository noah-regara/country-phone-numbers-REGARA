    ],
    "examples": [
      { "type": "fixed-line", "e164": "+96824212345", "international": "+968 2421 2345", "national": "2421 2345", "note": "Muscat — the 24xx block is Omantel fixed service" },
      { "type": "mobile", "e164": "+96891234567", "international": "+968 9123 4567", "national": "9123 4567", "note": "Mobile — 91xx is an Omantel range" },
      { "type": "mobile", "e164": "+96895342109", "international": "+968 9534 2109", "national": "9534 2109", "note": "Mobile — 95xx is an Ooredoo Oman range" }
    ],
    "notes": [
      "Oman's 8-digit NSN splits into a 4-digit national destination code and a 4-digit line number.",
      "No trunk prefix; the full 8 digits are dialled for every domestic call."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Oman",
      "TRA Oman — Telecommunications Regulatory Authority: https://www.tra.gov.om/"
