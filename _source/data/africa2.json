    },
    "patterns": [
      { "label": "Fixed line (2XX)", "national": "2XX XX XX XX", "international": "+237 2XX XX XX XX" },
      { "label": "Mobile (6XX)", "national": "6XX XX XX XX", "international": "+237 6XX XX XX XX" }
