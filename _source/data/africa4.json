[
  {
    "iso2": "NA",
    "callingCode": "+264",
    "trunkPrefix": "0",
    "internationalPrefix": "00",
    "nsnLengths": [9],
    "formats": { "national": "0AA XXX XXXX", "international": "+264 AA XXX XXXX (trunk 0 dropped)" },
    "patterns": [
      { "label": "Windhoek (061)", "national": "061 XXX XXXX", "international": "+264 61 XXX XXXX" },
      { "label": "Other regions (2-digit area codes)", "national": "0XX XXX XXXX", "international": "+264 XX XXX XXXX" },
      { "label": "Mobile — MTC (081), MTN (084), tn mobile (085)", "national": "081 XXX XXXX", "international": "+264 81 XXX XXXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+264611234567", "international": "+264 61 123 4567", "national": "061 123 4567", "note": "Windhoek — area code 061" },
      { "type": "mobile", "e164": "+264811234567", "international": "+264 81 123 4567", "national": "081 123 4567", "note": "Mobile — 081 is an MTC range" }
    ],
    "notes": [
      "Namibia's plan was originally part of South Africa's; the ITU allocated +264 in the late 1960s and it came into full use after independence in 1990.",
      "The international access prefix changed from 09 to 00."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Namibia",
      "CRAN — Communications Regulatory Authority of Namibia: https://www.cran.na/"
    ]
  },
  {
    "iso2": "MW",
    "callingCode": "+265",
    "trunkPrefix": "",
    "internationalPrefix": "00",
    "nsnLengths": [7, 9],
    "formats": { "national": "X XXX XXX (7-digit) / X XXXX XXXX (9-digit)", "international": "+265 X XXX XXX" },
    "patterns": [
      { "label": "Geographic — Malawi Telecom (1)", "national": "1 XXX XXX", "international": "+265 1 XXX XXX" },
      { "label": "Mobile — TNM (8), Airtel (9)", "national": "9 XXXX XXXX", "international": "+265 9 XXXX XXXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+2651234567", "international": "+265 1 234 567", "national": "1 234 567", "note": "Lilongwe — Malawi Telecom geographic numbers on the 1 prefix are 7 digits" },
      { "type": "mobile", "e164": "+265981234567", "international": "+265 9 8123 4567", "national": "9 8123 4567", "note": "Mobile — 9 is an Airtel Malawi range; mobile NSNs are 9 digits" }
    ],
    "notes": [
      "Malawi has no area codes; the leading digit identifies the operator and service.",
      "Legacy 7-digit geographic numbers on the 1 prefix coexist with 9-digit numbers introduced after the 2009 plan revision, so length varies."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Malawi",
      "MACRA — Malawi Communications Regulatory Authority: https://www.macra.mw/"
    ]
  },
  {
