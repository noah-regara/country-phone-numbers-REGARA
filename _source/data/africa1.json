      { "label": "Mobile — Ethio telecom (09X)", "national": "091 XXX XXXX", "international": "+251 91 XXX XXXX" },
      { "label": "Mobile — Safaricom Ethiopia (07X)", "national": "070 XXX XXXX", "international": "+251 70 XXX XXXX" }
