[
  {
    "iso2": "NG",
    "callingCode": "+234",
    "trunkPrefix": "0",
    "internationalPrefix": "009",
    "nsnLengths": [10],
    "formats": {
      "national": "0AAA XXX XXXX (landline) / 0AAA XXX XXXX (mobile)",
      "international": "+234 AAA XXX XXXX (trunk 0 dropped)"
    },
    "patterns": [
      { "label": "Lagos (0201)", "national": "0201 XXX XXXX", "international": "+234 201 XXX XXXX" },
      { "label": "Abuja (0209)", "national": "0209 XXX XXXX", "international": "+234 209 XXX XXXX" },
      { "label": "Mobile (070X, 080X, 081X, 090X, 091X)", "national": "0803 XXX XXXX", "international": "+234 803 XXX XXXX" },
      { "label": "Toll-free", "national": "0800 XXX XXXX", "international": "+234 800 XXX XXXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+2342012345678", "international": "+234 201 234 5678", "national": "0201 234 5678", "note": "Lagos — '20' was prepended to every fixed-line area code in 2023, so the old 01 became 0201" },
      { "type": "mobile", "e164": "+2348031234567", "international": "+234 803 123 4567", "national": "0803 123 4567", "note": "Mobile — 0803 is an MTN Nigeria range, though portability makes this indicative only" },
      { "type": "toll-free", "e164": "+2348001234567", "international": "+234 800 123 4567", "national": "0800 123 4567", "note": "Toll-free" }
    ],
    "notes": [
      "Nigeria renumbered fixed lines in 2023 by prefixing '20' to every geographic area code; the grace period for the old codes ended on 2024-01-01.",
      "The international access prefix is 009, not 00.",
      "Mobile numbers are 11 digits nationally including the trunk 0."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_Nigeria",
      "NCC — Nigerian Communications Commission: https://www.ncc.gov.ng/"
    ]
  },
  {
    "iso2": "ZA",
    "callingCode": "+27",
    "trunkPrefix": "0",
    "internationalPrefix": "00",
    "nsnLengths": [9],
    "formats": {
      "national": "0AA XXX XXXX",
      "international": "+27 AA XXX XXXX (trunk 0 dropped)"
    },
    "patterns": [
      { "label": "Johannesburg / Gauteng (011)", "national": "011 XXX XXXX", "international": "+27 11 XXX XXXX" },
      { "label": "Cape Town / Western Cape (021), Durban / KZN (031)", "national": "021 XXX XXXX", "international": "+27 21 XXX XXXX" },
      { "label": "Mobile (060–069, 071–079, 081–084)", "national": "082 XXX XXXX", "international": "+27 82 XXX XXXX" },
      { "label": "Toll-free", "national": "0800 XXX XXX", "international": "+27 800 XXX XXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+27111234567", "international": "+27 11 123 4567", "national": "011 123 4567", "note": "Johannesburg — area code 011" },
      { "type": "fixed-line", "e164": "+27211234567", "international": "+27 21 123 4567", "national": "021 123 4567", "note": "Cape Town — area code 021" },
      { "type": "mobile", "e164": "+27821234567", "international": "+27 82 123 4567", "national": "082 123 4567", "note": "Mobile — 082 is a Vodacom range" },
      { "type": "toll-free", "e164": "+27800123456", "international": "+27 800 123 456", "national": "0800 123 456", "note": "Toll-free" }
    ],
    "notes": [
      "South Africa moved to a closed numbering plan on 2007-01-16: the full 10-digit national form (trunk 0 + 9-digit NSN) is required even for local calls.",
      "Administered by ICASA."
    ],
    "sources": [
      "https://en.wikipedia.org/wiki/Telephone_numbers_in_South_Africa",
      "ICASA — Independent Communications Authority of South Africa: https://www.icasa.org.za/"
    ]
  },
  {
