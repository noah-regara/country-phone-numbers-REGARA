    "patterns": [
      { "label": "Skopje (02)", "national": "02 XXX XXXX", "international": "+389 2 XXX XXXX" },
      { "label": "Other geographic (031–047)", "national": "0XX XXX XXX", "international": "+389 XX XXX XXX" },
      { "label": "Mobile (070–078)", "national": "070 XXX XXX", "international": "+389 70 XXX XXX" }
    ],
    "examples": [
      { "type": "fixed-line", "e164": "+38921234567", "international": "+389 2 123 4567", "national": "02 123 4567", "note": "Skopje — single-digit area code 2" },
      { "type": "fixed-line", "e164": "+38946123456", "international": "+389 46 123 456", "national": "046 123 456", "note": "Ohrid — area code 046" },
      { "type": "mobile", "e164": "+38970123456", "international": "+389 70 123 456", "national": "070 123 456", "note": "Mobile — 070–072 Makedonski Telekom, 075–078 A1" }
    ],
    "notes": [
      "Closed 8-digit plan. The area code must always be dialled domestically because many fixed and mobile operators share the plan.",
