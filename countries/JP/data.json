{
  "country": "Japan",
  "iso2": "JP",
  "iso3": "JPN",
  "callingCode": "+81",
  "trunkPrefix": "0",
  "internationalPrefix": "010",
  "nsnLengths": [
    9,
    10
  ],
  "formats": {
    "national": "0A-XXXX-XXXX (major cities) / 0AAAA-XX-XXXX (rural)",
    "international": "+81 A XXXX XXXX (trunk 0 dropped)"
  },
  "patterns": [
    {
      "label": "Tokyo (03), Osaka (06)",
      "national": "03-XXXX-XXXX",
      "international": "+81 3 XXXX XXXX"
    },
    {
      "label": "Regional (2–5 digit area codes)",
      "national": "0XX-XXX-XXXX",
      "international": "+81 XX XXX XXXX"
    },
    {
      "label": "Mobile (070, 080, 090)",
      "national": "090-XXXX-XXXX",
      "international": "+81 90 XXXX XXXX"
    },
    {
      "label": "Toll-free (free dial)",
      "national": "0120-XXX-XXX",
      "international": "+81 120 XXX XXX"
    }
  ],
  "examples": [
    {
      "type": "fixed-line",
      "e164": "+81312345678",
      "international": "+81 3 1234 5678",
      "national": "03-1234-5678",
      "note": "Tokyo — area code 3, the shortest in Japan"
    },
    {
      "type": "fixed-line",
      "e164": "+81612345678",
      "international": "+81 6 1234 5678",
      "national": "06-1234-5678",
      "note": "Osaka — area code 6"
    },
    {
      "type": "mobile",
      "e164": "+819012345678",
      "international": "+81 90 1234 5678",
      "national": "090-1234-5678",
      "note": "Mobile — 070, 080 and 090 are the mobile prefixes"
    },
    {
      "type": "toll-free",
      "e164": "+81120123456",
      "international": "+81 120 123 456",
      "national": "0120-123-456",
      "note": "Free dial (フリーダイヤル)"
    }
  ],
  "notes": [
    "Japan's international access prefix is 010, not 00.",
    "Area code length is inversely proportional to population density: Tokyo is a single digit (3), while rural areas run to five digits. The subscriber number shrinks to compensate.",
    "Area codes increase roughly north to south — Sapporo 11, Kagoshima 99.",
    "Numbers are conventionally written with hyphens."
  ],
  "sources": [
    "https://en.wikipedia.org/wiki/Telephone_numbers_in_Japan",
    "MIC — Ministry of Internal Affairs and Communications: https://www.soumu.go.jp/main_sosiki/joho_tsusin/top/tel_number/"
  ]
}
