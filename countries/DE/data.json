  "patterns": [
    {
      "label": "Geographic, 2-digit area code (Berlin 30, Hamburg 40, Munich 89)",
      "national": "030 XXXXXXXX",
      "international": "+49 30 XXXXXXXX"
    },
    {
      "label": "Geographic, 3-digit area code (Cologne 221, Frankfurt 69)",
      "national": "0221 XXXXXXX",
      "international": "+49 221 XXXXXXX"
    },
    {
