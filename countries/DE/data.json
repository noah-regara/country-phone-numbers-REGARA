    },
    {
      "label": "Mobile",
      "national": "0151 XXXXXXXX",
      "international": "+49 151 XXXXXXXX"
    },
    {
      "label": "Freephone",
      "national": "0800 XXXXXXX",
      "international": "+49 800 XXXXXXX"
    }
  ],
  "examples": [
    {
      "type": "fixed-line",
      "e164": "+493022360",
      "international": "+49 30 22360",
      "national": "030 22360",
      "note": "Berlin — area code 030; subscriber numbers are genuinely variable length"
    },
    {
      "type": "fixed-line",
