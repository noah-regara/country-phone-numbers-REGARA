    },
    {
      "label": "Mobile — Alfa (03, 071, 076, 078, 079), touch (03, 070, 081)",
      "national": "071 XXX XXX",
      "international": "+961 71 XXX XXX"
    }
  ],
  "examples": [
    {
      "type": "fixed-line",
      "e164": "+9611123456",
      "international": "+961 1 123 456",
