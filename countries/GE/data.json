      "national": "0 4XX XX XXXX",
      "international": "+995 4XX XX XXXX"
    },
    {
      "label": "Mobile (5XX)",
      "national": "0 5XX XXX XXX",
      "international": "+995 5XX XXX XXX"
    },
    {
      "label": "Fixed wireless (7XX)",
      "national": "0 7XX XXX XXX",
      "international": "+995 7XX XXX XXX"
    }
  ],
  "examples": [
    {
      "type": "fixed-line",
      "e164": "+995322123456",
      "international": "+995 32 212 3456",
      "national": "0 32 212 3456",
      "note": "Tbilisi — area code 32; Tbilisi subscriber numbers begin with 2"
    },
    {
      "type": "mobile",
      "e164": "+995595123456",
