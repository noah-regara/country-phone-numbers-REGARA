{
  "country": "United Kingdom of Great Britain and Northern Ireland",
  "iso2": "GB",
  "iso3": "GBR",
  "callingCode": "+44",
  "trunkPrefix": "0",
  "internationalPrefix": "00",
  "nsnLengths": [
    9,
    10
  ],
  "formats": {
    "national": "0AA XXXX XXXX / 0AAAA XXXXXX (grouping depends on area-code length)",
    "international": "+44 AA XXXX XXXX (trunk 0 dropped)"
  },
  "patterns": [
    {
      "label": "Geographic, 2-digit area code (London 20, Southampton 23)",
      "national": "020 XXXX XXXX",
      "international": "+44 20 XXXX XXXX"
    },
    {
      "label": "Geographic, 3-digit area code (Manchester 161, Birmingham 121)",
      "national": "0161 XXX XXXX",
      "international": "+44 161 XXX XXXX"
    },
    {
      "label": "Geographic, 4-digit area code (most towns)",
      "national": "01XXX XXXXXX",
      "international": "+44 1XXX XXXXXX"
    },
    {
      "label": "Mobile",
      "national": "07XXX XXXXXX",
      "international": "+44 7XXX XXXXXX"
    },
    {
      "label": "Freephone",
      "national": "0800 XXX XXXX",
      "international": "+44 800 XXX XXXX"
    },
    {
      "label": "Non-geographic / national rate",
      "national": "0345 XXX XXXX",
      "international": "+44 345 XXX XXXX"
    }
  ],
  "examples": [
    {
      "type": "fixed-line",
      "e164": "+442071234567",
      "international": "+44 20 7123 4567",
      "national": "020 7123 4567",
      "note": "London — area code 020, subscriber block 7xxx"
    },
    {
      "type": "fixed-line",
      "e164": "+441612361234",
      "international": "+44 161 236 1234",
      "national": "0161 236 1234",
      "note": "Manchester — area code 0161"
    },
    {
      "type": "mobile",
      "e164": "+447400123456",
      "international": "+44 7400 123456",
      "national": "07400 123456",
      "note": "Mobile — 07400 is an allocated Great Britain mobile range (07911 was previously shown here, but 079111 is allocated to Guernsey)"
    },
    {
      "type": "toll-free",
      "e164": "+448001234567",
      "international": "+44 800 123 4567",
      "national": "0800 123 4567",
      "note": "Freephone"
    }
  ],
  "notes": [
    "The trunk prefix 0 is part of the national presentation but is never dialled from abroad.",
    "Area codes are variable length (2–5 digits after the 0); the subscriber number shrinks to match, keeping the NSN at 10 digits for almost all numbers.",
    "Ofcom reserves 07700 900000–900999 and 020 7946 0xxx as fictitious 'drama' ranges for film and TV; the examples above deliberately use real allocated ranges instead."
  ],
  "sources": [
    "https://en.wikipedia.org/wiki/Telephone_numbers_in_the_United_Kingdom",
    "Ofcom — National Telephone Numbering Plan: https://www.ofcom.org.uk/phones-and-broadband/phone-numbers/numbering/"
  ]
}
