{
  "country": "Rwanda",
  "iso2": "RW",
  "iso3": "RWA",
  "callingCode": "+250",
  "trunkPrefix": "0",
  "internationalPrefix": "00",
  "nsnLengths": [
    9
  ],
  "formats": {
    "national": "0NNN XXX XXX",
    "international": "+250 NNN XXX XXX"
  },
  "patterns": [
    {
      "label": "Fixed line (25X)",
      "national": "0250 XXX XXX",
      "international": "+250 250 XXX XXX"
    },
    {
      "label": "Mobile — MTN (078, 079), Airtel (073, 072)",
      "national": "0788 XXX XXX",
      "international": "+250 788 XXX XXX"
    }
  ],
  "examples": [
    {
      "type": "fixed-line",
      "e164": "+250250512345",
      "international": "+250 250 512 345",
      "national": "0250 512 345",
      "note": "Kigali — geographic landlines begin with 25"
    },
    {
      "type": "mobile",
      "e164": "+250788123456",
      "international": "+250 788 123 456",
      "national": "0788 123 456",
      "note": "Mobile — 78 is an MTN Rwanda range"
    },
    {
      "type": "mobile",
      "e164": "+250730123456",
      "international": "+250 730 123 456",
      "national": "0730 123 456",
      "note": "Mobile — 73 range"
    }
  ],
  "notes": [
    "The Rwanda Utilities Regulatory Authority introduced the current numbering plan in February 2009.",
    "The NSN is 9 digits: a 3-digit national destination code plus a 6-digit subscriber number.",
    "Mobile prefixes are 72, 73 and 78; geographic landlines begin 25."
  ],
  "sources": [
    "https://en.wikipedia.org/wiki/Telephone_numbers_in_Rwanda",
    "RURA — Rwanda Utilities Regulatory Authority: https://rura.rw/"
  ]
}
