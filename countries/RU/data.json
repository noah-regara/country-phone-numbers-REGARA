{
  "country": "Russian Federation",
  "iso2": "RU",
  "iso3": "RUS",
  "callingCode": "+7",
  "trunkPrefix": "8",
  "internationalPrefix": "810",
  "nsnLengths": [
    10
  ],
  "formats": {
    "national": "8 AAA XXX-XX-XX",
    "international": "+7 AAA XXX XX XX"
  },
  "patterns": [
    {
      "label": "Moscow (495, 499)",
      "national": "8 495 XXX-XX-XX",
      "international": "+7 495 XXX XX XX"
    },
    {
      "label": "Saint Petersburg (812)",
      "national": "8 812 XXX-XX-XX",
      "international": "+7 812 XXX XX XX"
    },
    {
      "label": "Mobile (9XX)",
      "national": "8 985 XXX-XX-XX",
      "international": "+7 985 XXX XX XX"
    },
    {
      "label": "Freephone",
      "national": "8 800 XXX-XX-XX",
      "international": "+7 800 XXX XX XX"
    }
  ],
  "examples": [
    {
      "type": "fixed-line",
      "e164": "+74951234567",
      "international": "+7 495 123 45 67",
      "national": "8 495 123-45-67",
      "note": "Moscow — area code 495 (499 is the overlay)"
    },
    {
      "type": "fixed-line",
      "e164": "+78121234567",
      "international": "+7 812 123 45 67",
      "national": "8 812 123-45-67",
      "note": "Saint Petersburg — area code 812"
    },
    {
      "type": "mobile",
      "e164": "+79851234567",
      "international": "+7 985 123 45 67",
      "national": "8 985 123-45-67",
      "note": "Mobile — all Russian mobile codes begin with 9"
    },
    {
      "type": "toll-free",
      "e164": "+78001234567",
      "international": "+7 800 123 45 67",
      "national": "8 800 123-45-67",
      "note": "Freephone"
    }
  ],
  "notes": [
    "Russia shares country code +7 with Kazakhstan — the code alone does not identify the country.",
    "The trunk prefix is 8 (not 0) and the international access code is 8~10, dialled as 8 then 10 after a second dial tone.",
    "Closed plan: NSN is always 10 digits (3-digit area code + 7-digit subscriber number).",
    "All mobile area codes begin with 9, which is the reliable way to distinguish mobile from fixed."
  ],
  "sources": [
    "https://en.wikipedia.org/wiki/Telephone_numbers_in_Russia",
    "Ministry of Digital Development — Russian numbering plan: https://digital.gov.ru/"
  ]
}
