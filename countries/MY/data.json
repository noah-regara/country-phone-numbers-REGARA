      "note": "Kuala Lumpur — area code 03, the largest block"
    },
    {
      "type": "fixed-line",
      "e164": "+6041234567",
      "international": "+60 4 123 4567",
      "national": "04-123 4567",
      "note": "Penang — area code 04"
