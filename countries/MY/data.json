    {
      "label": "Kuala Lumpur / Selangor (03)",
      "national": "03-XXXX XXXX",
      "international": "+60 3 XXXX XXXX"
    },
    {
      "label": "Other states (04 Penang, 07 Johor, 088 Sabah)",
      "national": "04-XXX XXXX",
      "international": "+60 4 XXX XXXX"
    },
    {
      "label": "Mobile (010–019)",
      "national": "012-XXX XXXX",
      "international": "+60 12 XXX XXXX"
    },
    {
      "label": "Toll-free",
      "national": "1800-XX-XXXX",
      "international": "not reachable from abroad"
    }
  ],
  "examples": [
    {
      "type": "fixed-line",
      "e164": "+60321234567",
      "international": "+60 3 2123 4567",
