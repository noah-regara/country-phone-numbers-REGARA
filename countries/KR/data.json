    },
    {
      "label": "Busan (051), Incheon (032), Daegu (053)",
      "national": "051-XXX-XXXX",
      "international": "+82 51 XXX XXXX"
    },
    {
      "label": "Mobile (010)",
      "national": "010-XXXX-XXXX",
      "international": "+82 10 XXXX XXXX"
