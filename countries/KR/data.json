  "examples": [
    {
      "type": "fixed-line",
      "e164": "+8223123456",
      "international": "+82 2 312 3456",
      "national": "02-312-3456",
      "note": "Seoul — area code 02, the only single-digit code"
    },
    {
      "type": "fixed-line",
      "e164": "+82511234567",
