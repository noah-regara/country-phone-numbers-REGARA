    9
  ],
  "formats": {
    "national": "0AA X XXXXXX (fixed) / 0XX XXXXXXX (mobile)",
    "international": "+94 AA X XXXXXX (trunk 0 dropped)"
  },
  "patterns": [
    {
      "label": "Colombo (011)",
      "national": "011 X XXXXXX",
      "international": "+94 11 X XXXXXX"
    },
    {
      "label": "Other districts (2-digit area codes)",
      "national": "0XX X XXXXXX",
      "international": "+94 XX X XXXXXX"
    },
    {
      "label": "Mobile (070–078)",
      "national": "077 XXXXXXX",
      "international": "+94 77 XXXXXXX"
    }
  ],
  "examples": [
    {
      "type": "fixed-line",
      "e164": "+94112123456",
      "international": "+94 11 2 123456",
      "national": "011 2 123456",
      "note": "Colombo — area code 011; the digit after it identifies the fixed operator (2 = SLT-Mobitel)"
    },
    {
      "type": "mobile",
      "e164": "+94777123456",
      "international": "+94 77 7123456",
      "national": "077 7123456",
      "note": "Mobile — 077 is a Dialog Axiata range"
    },
    {
      "type": "mobile",
      "e164": "+94712345678",
      "international": "+94 71 2345678",
      "national": "071 2345678",
      "note": "Mobile — 071 is an SLT-Mobitel range"
    }
  ],
  "notes": [
    "Sri Lankan fixed numbers embed an operator digit between the area code and the 6-digit subscriber number.",
    "Mobile operator codes fall in the 070–078 range; the NSN is 9 digits for both fixed and mobile."
  ],
  "sources": [
    "https://en.wikipedia.org/wiki/Telephone_numbers_in_Sri_Lanka",
